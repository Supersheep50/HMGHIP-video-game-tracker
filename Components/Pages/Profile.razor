@page "/profile"
@implements IDisposable
@inject AuthStateService AuthState
@inject FirebaseService Firebase
@inject GameStateService GameState
@inject XpService Xp
@inject NavigationManager Nav

<PageTitle>My Profile — HMGHIP</PageTitle>

<div class="profile-page">

    @if (AuthState.CurrentUser != null)
    {
        <div class="profile-hero anim-fade-up">
            <div class="profile-avatar-wrap">
                @if (AuthState.CurrentUser.PhotoUrl != null)
                {
                    <img src="@AuthState.CurrentUser.PhotoUrl" class="profile-hero-avatar" alt="avatar" />
                }
                else
                {
                    <div class="profile-hero-avatar profile-hero-avatar-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                }
            </div>
            <h1 class="profile-display-name">@AuthState.CurrentUser.DisplayName</h1>
            @if (!string.IsNullOrWhiteSpace(_username))
            {
                <p class="profile-username">@("@" + _username)</p>
            }
            <p class="profile-email">@AuthState.CurrentUser.Email</p>
        </div>
    }
    else
    {
        <div class="profile-hero anim-fade-up">
            <div class="profile-hero-avatar profile-hero-avatar-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
            </div>
            <h1 class="profile-display-name">Guest</h1>
            <p class="profile-email">Not signed in</p>
            <a href="login" class="profile-signin-btn">Sign in with Google</a>
        </div>
    }

    @if (AuthState.IsAuthenticated && AuthState.CurrentUser != null)
    {
        var lvl  = Xp.CurrentLevel;
        var next = Xp.NextLevel;
        var pct  = Math.Round(Xp.Progress * 100);

        <div class="xp-card anim-fade-up">
            <div class="xp-card-badge-wrap">
                <div class="xp-card-badge-ring" style="--xp-ring: @pct%"></div>
                <div class="xp-card-badge">
                    <span class="xp-card-badge-icon">@lvl.Badge</span>
                </div>
                <div class="xp-card-badge-num">@lvl.Number</div>
            </div>

            <div class="xp-card-level-label">Level @lvl.Number</div>
            <h2 class="xp-card-level-name">@lvl.Name</h2>
            <div class="xp-card-level-num">@Xp.Xp XP total</div>

            <div class="xp-card-track">
                <div class="xp-card-fill" style="width: @pct%"></div>
            </div>

            @if (next != null)
            {
                <div class="xp-card-numbers">
                    <span><strong>@Xp.Xp</strong></span>
                    <span class="xp-card-numbers-mid">@(next.XpRequired - Xp.Xp) XP to next</span>
                    <span><strong>@next.XpRequired</strong></span>
                </div>
                <div class="xp-card-next">
                    <span>Next:</span>
                    <span class="xp-card-next-badge">@next.Badge</span>
                    <span><strong>Lvl @next.Number</strong> — @next.Name</span>
                </div>
            }
            else
            {
                <div class="xp-card-numbers">
                    <span><strong>@Xp.Xp</strong> XP</span>
                </div>
                <div class="xp-card-max">🏆 Max level reached</div>
            }

            <div class="xp-journey">
                @foreach (var step in XpLevels.All)
                {
                    var state = step.Number < lvl.Number ? "done"
                              : step.Number == lvl.Number ? "current" : "locked";
                    <div class="xp-journey-step xp-journey-@state" title="Lvl @step.Number — @step.Name">
                        <span class="xp-journey-badge">@step.Badge</span>
                        <span class="xp-journey-num">@step.Number</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (AuthState.CurrentUser != null && _games.Any())
    {
        <div class="profile-stats-card anim-fade-up">
            <h2 class="profile-stats-title">Your Gaming Life</h2>
            <div class="profile-stats-grid">
                <div class="profile-stat"><span class="profile-stat-num">@_games.Count</span><span class="profile-stat-label">Games</span></div>
                <div class="profile-stat"><span class="profile-stat-num">@_finishedCount</span><span class="profile-stat-label">Finished</span></div>
                <div class="profile-stat"><span class="profile-stat-num">@_games.Sum(g => g.HoursPlayed).ToString("N0")</span><span class="profile-stat-label">Hours</span></div>
                <div class="profile-stat"><span class="profile-stat-num">@_games.Count(g => g.Review > 0)</span><span class="profile-stat-label">Rated</span></div>
                <div class="profile-stat"><span class="profile-stat-num">@(_games.Any(g => g.Review > 0) ? _games.Where(g => g.Review > 0).Average(g => g.Review).ToString("F1") : "—")</span><span class="profile-stat-label">Avg Score</span></div>
                <div class="profile-stat"><span class="profile-stat-num">@_games.Count(g => g.Liked)</span><span class="profile-stat-label">Liked</span></div>
            </div>
            @if (_topGenres.Any())
            {
                <div class="profile-genres">
                    <div class="profile-genres-title">Top Genres</div>
                    @foreach (var (genre, count) in _topGenres)
                    {
                        <div class="profile-genre-row">
                            <span class="profile-genre-name">@genre</span>
                            <div class="profile-genre-track">
                                <div class="profile-genre-fill" style="width:@(count * 100 / _topGenres[0].Count)%; background:@GameVisuals.Gradient(genre)"></div>
                            </div>
                            <span class="profile-genre-count">@count</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_top3.Any())
    {
        <div class="profile-stats-card anim-fade-up">
            <h2 class="profile-stats-title">My Top 3</h2>
            <div class="profile-top3-row">
                @{ int rank = 1; }
                @foreach (var t in _top3)
                {
                    <a href="top3" class="profile-top3-tile"
                       style="@(t.ArtUrl != null ? $"background-image:url('{t.ArtUrl}')" : $"background:{GameVisuals.Gradient(t.Genre)}")">
                        <span class="profile-top3-badge">#@(rank++)</span>
                        <span class="profile-top3-name">@t.Name</span>
                    </a>
                }
            </div>
        </div>
    }

    <div class="profile-actions anim-fade-up">
        @if (AuthState.IsAuthenticated && !AuthState.IsGuest)
        {
            <a href="logout" class="profile-signout-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                Sign Out
            </a>
        }
    </div>

</div>

@code {
    private string? _username;
    private List<Games> _games = new();
    private int _finishedCount;
    private List<(string Genre, int Count)> _topGenres = new();
    private List<(string Name, string? ArtUrl, string? Genre)> _top3 = new();

    protected override async Task OnInitializedAsync()
    {
        Xp.OnChanged += HandleXpChanged;
        GameState.OnChanged += HandleGamesChanged;
        AuthState.OnChange  += HandleAuthChanged;
        await Xp.EnsureLoadedAsync();
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        if (AuthState.CurrentUser == null) return;

        var profileTask = Firebase.GetProfileAsync(AuthState.CurrentUser.Uid);
        _games = await Firebase.GetGamesAsync(AuthState.CurrentUser.Uid);
        var statuses = await Firebase.GetGameStatusesAsync(AuthState.CurrentUser.Uid);
        _finishedCount = statuses.Count(s => s.Value == "finished");
        _username = (await profileTask)?.Username;

        _topGenres = _games
            .Where(g => !string.IsNullOrWhiteSpace(g.Genre))
            .GroupBy(g => g.Genre!)
            .Select(gr => (gr.Key, gr.Count()))
            .OrderByDescending(t => t.Item2)
            .Take(3)
            .ToList();

        var top3 = await Firebase.GetTop3Async(AuthState.CurrentUser.Uid);
        _top3 = top3
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Select(n =>
            {
                var g = _games.FirstOrDefault(x => string.Equals(x.Name, n, StringComparison.OrdinalIgnoreCase));
                return (n!, g?.GameArtUrl, g?.Genre);
            })
            .ToList();
    }

    private void HandleXpChanged() => InvokeAsync(StateHasChanged);

    private async void HandleGamesChanged()
    {
        await LoadStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleAuthChanged()
    {
        await Xp.EnsureLoadedAsync();
        await LoadStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Xp.OnChanged -= HandleXpChanged;
        GameState.OnChanged -= HandleGamesChanged;
        AuthState.OnChange  -= HandleAuthChanged;
    }
}
